{
  "mcpServers": {
    "aurum": {
      "type": "stdio",
      "command": "aurumcode",
      "args": ["mcp", "--tempo", "10m", "--limite", "0.50"],
      "env": {
        "LLM_API_KEY": "${LLM_API_KEY}",
        "LLM_BASE_URL": "${LLM_BASE_URL:-https://api.anthropic.com/v1}",
        "LLM_PROVIDER": "${LLM_PROVIDER:-anthropic}",
        "LLM_MODEL": "${LLM_MODEL:-claude-haiku-5-5}"
      }
    }
  }
}
